  urldate = {2025-02-08},
  abstract = {We present optimal Bayesian field-level cosmological constraints from nonlinear tracers of the large-scale structure, specifically the amplitude \$\textbackslash sigma\_8\$ of linear matter fluctuations inferred from rest-frame simulated dark matter halos in a comoving volume of \$8\textbackslash,(h\textasciicircum\textbraceleft -1\textbraceright\textbackslash mathrm\textbraceleft Gpc\textbraceright )\textasciicircum 3\$. Our constraint on \$\textbackslash sigma\_8\$ is entirely due to nonlinear information, and obtained by explicitly sampling the initial conditions along with bias and noise parameters via a Lagrangian EFT-based forward model, LEFTfield. The comparison with a simulation-based inference analysis employing the power spectrum and bispectrum -- likewise using the LEFTfield forward model -- shows that, when including precisely the same modes of the same data up to \$k\_\textbraceleft\textbackslash mathrm\textbraceleft max\textbraceright\textbraceright = 0.10\textbackslash,h\textbackslash,\textbackslash mathrm\textbraceleft Mpc\textbraceright\textasciicircum\textbraceleft -1\textbraceright\$ (\$0.12\textbackslash,h\textbackslash,\textbackslash mathrm\textbraceleft Mpc\textbraceright\textasciicircum\textbraceleft -1\textbraceright\$), the field-level approach yields a factor of 3.5 (5.2) improvement on the \$\textbackslash sigma\_8\$ constraint, from 20.0\% to 5.7\% (17.0\% to 3.3\%). This study provides direct insights into cosmological information encoded in galaxy clustering beyond low-order \$n\$-point functions.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics,Astrophysics - Instrumentation and Methods for Astrophysics},
  file = {/Users/ksf/Zotero/storage/M7Y9BIIF/Nguyen et al. - 2024 - How much information can be extracted from galaxy .pdf;/Users/ksf/Zotero/storage/FLPQJ4GK/2403.html}
