  urldate = {2023-08-15},
  abstract = {Recently, hybrid bias expansions have emerged as a powerful approach to modelling the way in which galaxies are distributed in the Universe. Similarly, field-level emulators have recently become possible thanks to advances in machine learning and \$N\$-body simulations. In this paper we explore whether both techniques can be combined to provide a field-level model for the clustering of galaxies in real and redshift space. Specifically, here we will demonstrate that field-level emulators are able to accurately predict all the operators of a \$2\textasciicircum\textbraceleft\textbackslash rm nd\textbraceright\$-order hybrid bias expansion. The precision achieved in real and redshift space is similar to that obtained for the nonlinear matter power spectrum. This translates to roughly 1-2\textbackslash\% precision for the power spectrum of a BOSS and a Euclid-like galaxy sample up to \$k\textbackslash sim 0.6 h\textasciicircum\textbraceleft -1\textbraceright\$Mpc. Remarkably, this combined approach also delivers precise predictions for field-level galaxy statistics. Despite all these promising results, we detect several areas where further improvements are required. Therefore, this work serves as a road-map for the developments required for a more complete exploitation of upcoming large-scale structure surveys.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics},
  file = {/Users/ksf/Zotero/storage/NHF3K34F/Ibanez et al. - 2023 - Hybrid-bias and displacement emulators for field-l.pdf;/Users/ksf/Zotero/storage/RTELVQ9Q/2307.html}
}

@article{pellejero-ibanez_bacco_2023,
  title = {The {{Bacco Simulation Project}}: {{Bacco Hybrid Lagrangian Bias Expansion Model}} in {{Redshift Space}}},
  shorttitle = {The {{Bacco Simulation Project}}},
  author = {{Pellejero-Ibanez}, Marcos and Angulo, Raul E. and Zennaro, Matteo and Stuecker, Jens and Contreras, Sergio and Arico, Giovanni and Maion, Francisco},
  year = 2023,
