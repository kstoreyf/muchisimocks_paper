  primaryclass = {astro-ph},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2310.15243},
  urldate = {2025-02-08},
  abstract = {We present the first cosmological constraints from analyzing higher-order galaxy clustering on non-linear scales. We use \$\textbraceleft\textbackslash rm S\textbraceleft\textbackslash scriptsize IM\textbraceright BIG\textbraceright\$, a forward modeling framework for galaxy clustering analyses that employs simulation-based inference to perform highly efficient cosmological inference using normalizing flows. It leverages the predictive power of high-fidelity simulations and robustly extracts cosmological information from regimes inaccessible with current standard analyses. In this work, we apply \$\textbraceleft\textbackslash rm S\textbraceleft\textbackslash scriptsize IM\textbraceright BIG\textbraceright\$ to a subset of the BOSS galaxy sample and analyze the redshift-space bispectrum monopole, \$B\_0(k\_1, k\_2, k\_3)\$, to \$k\_\textbraceleft\textbackslash rm max\textbraceright =0.5\textbackslash,h/\textbraceleft\textbackslash rm Mpc\textbraceright\$. We achieve 1\$\textbackslash sigma\$ constraints of \$\textbackslash Omega\_m=0.293\textasciicircum\textbraceleft +0.027\textbraceright\_\textbraceleft -0.027\textbraceright\$ and \$\textbackslash sigma\_8= 0.783\textasciicircum\textbraceleft +0.040\textbraceright\_\textbraceleft -0.038\textbraceright\$, which are more than 1.2 and 2.4\$\textbackslash times\$ tighter than constraints from standard power spectrum analyses of the same dataset. We also derive 1.4, 1.4, 1.7\$\textbackslash times\$ tighter constraints on \$\textbackslash Omega\_b\$, \$h\$, \$n\_s\$. This improvement comes from additional cosmological information in higher-order clustering on non-linear scales and, for \$\textbackslash sigma\_8\$, is equivalent to the gain expected from a standard analysis on a \$\textbackslash sim\$4\$\textbackslash times\$ larger galaxy sample. Even with our BOSS subsample, which only spans 10\% of the full BOSS volume, we derive competitive constraints on the growth of structure: \$S\_8 = 0.774\textasciicircum\textbraceleft +0.056\textbraceright\_\textbraceleft -0.053\textbraceright\$. Our constraint is consistent with results from both cosmic microwave background and weak lensing. Combined with a \$\textbackslash omega\_b\$ prior from Big Bang Nucleosynthesis, we also derive a constraint on \$H\_0=67.6\textasciicircum\textbraceleft +2.2\textbraceright\_\textbraceleft -1.8\textbraceright\textbackslash,\textbraceleft\textbackslash rm km\textbackslash,s\textasciicircum\textbraceleft -1\textbraceright\textbackslash,Mpc\textasciicircum\textbraceleft -1\textbraceright\textbraceright\$ that is consistent with early universe constraints.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics},
  file = {/Users/ksf/Zotero/storage/MVRHP374/Hahn et al. - 2023 - $ rm S scriptsize IM BIG $ The First Cosmologic.pdf;/Users/ksf/Zotero/storage/RXWQRAH7/2310.html}
}

@article{hahn_rm_2023-2,
  title = {\$\textbraceleft\textbackslash rm {{S}}\textbraceleft\textbackslash scriptsize {{IM}}\textbraceright{{BIG}}\textbraceright\$: {{Mock Challenge}} for a {{Forward Modeling Approach}} to {{Galaxy Clustering}}},
  shorttitle = {\$\textbraceleft\textbackslash rm {{S}}\textbraceleft\textbackslash scriptsize {{IM}}\textbraceright{{BIG}}\textbraceright\$},
  author = {Hahn, ChangHoon and Eickenberg, Michael and Ho, Shirley and Hou, Jiamin and Lemos, Pablo and Massara, Elena and Modi, Chirag and Dizgah, Azadeh Moradinezhad and Blancard, Bruno R{\'e}galdo-Saint and Abidi, Muntazir M.},
  year = 2023,
